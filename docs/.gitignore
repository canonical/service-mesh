# Environment
# NOTE: Do not use a glob such as '*env*/' here. It matches any directory whose
# name merely contains "env" -- including doc directories like 'envoy/'. Virtual
# environments are already ignored repo-wide by the root .gitignore.
.sphinx/venv/

# Sphinx
.sphinx/warnings.txt
.sphinx/.wordlist.dic
.sphinx/.doctrees/
.sphinx/update/
.sphinx/node_modules/

# Vale
.sphinx/styles/*
.sphinx/vale.ini

# Build outputs
_build

# sphinx-autoapi output, regenerated from canonical_service_mesh on every build
# (see autoapi_root / autoapi_keep_files in conf.py). Never read as input.
istio/reference/canonical_service_mesh/

# Node.js
package*.json

# Unrelated cache and config files
.DS_Store
__pycache__
.idea/
.vscode/
